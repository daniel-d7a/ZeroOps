# ZeroOps environment — copy to .env and fill in the secrets.
# Generate secrets with:  openssl rand -hex 32

# --- console / apps -------------------------------------------------
BASE_DOMAIN=localhost
PUBLIC_PORT=8080            # host port in live URLs (empty = none, when 80 is free)
REGISTRATION_ENABLED=true

# --- first admin (seeded at startup if no admin exists) -------------
ADMIN_EMAIL=admin@localhost.com
ADMIN_PASSWORD=change-me-now

# --- secrets (32 bytes hex each) ------------------------------------
SESSION_SECRET=
ENCRYPTION_KEY=

# --- platform-db (users, projects, deployments) ---------------------
PLATFORM_DB_USER=zeroops
PLATFORM_DB_PASSWORD=
PLATFORM_DB_NAME=zeroops

# --- student-db (worker administers project databases) --------------
STUDENT_DB_PASSWORD=

# --- rabbitmq --------------------------------------------------------
RABBITMQ_DEFAULT_USER=zeroops
RABBITMQ_DEFAULT_PASSWORD=

# --- quotas (overridable) -------------------------------------------
MAX_PROJECTS_PER_USER=3
MAX_SOURCES_BYTES_PER_USER=524288000
MAX_ENV_VARS_PER_PROJECT=50
